# Fixed string buffers for the current, package-less ttp.proto schema.
# max_size includes the terminating NUL; limits below are UTF-8 bytes.

# 32-byte buffer: up to 31 text bytes plus NUL.
GetTestInfoResp.name          max_size:32

# 64-byte buffers: up to 63 text bytes plus NUL.
LogEvent.message             max_size:64
TestStepEvent.description    max_size:64
